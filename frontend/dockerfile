FROM node:20-alpine as DEVELOPMENT

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY eslint.config.mjs ./
COPY tsconfig.json ./
COPY next-env.d.ts ./
COPY next.config.ts ./
COPY postcss.config.mjs ./
COPY public/ ./public/
COPY src/ ./src/

# RUN cp backend/.env.example backend/.env


COPY . .


CMD ["npm", "run", "dev"]
